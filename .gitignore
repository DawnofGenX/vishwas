.delegation/*
.test-quarantine/
logs/
__pycache__/
*.pyc
*.egg-info/
output/renders/

# agent-local session runtime (plans moved to tracked docs/plans/)
.hermes/

# test fixtures are versioned; delegation notes stay ignored
!.delegation/fixtures/

# local-only secrets & runtime env
/deploy/.env
/deploy/openwa-reply.env
/deploy/verisafe-secrets.env
/deploy/vishwas-secrets.env

# vendored Spectra-AASIST3 base-encoder weights stay OUT of git (1.27GB); the
# arch reads them from /opt/verisafe/models/aasist3/wav2vec2-xls-r-300m/
src/vishwas/model_archs/_spectra/wav2vec2-xls-r-300m/*.bin

# Secrets and local credentials (the tracked .pem under
# .delegation/fixtures/ is a public test certificate, not a key)
.env
.env.*
!.env.example
*.key
*.p12
.pypirc
.netrc
credentials.json

# Per-user reply-language preferences. This is RUNTIME STATE that maps real
# WhatsApp JIDs to their chosen language, so it must never be committed: it
# is both personal data and machine-specific. The app recreates it.
user_prefs.json
